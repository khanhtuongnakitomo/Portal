NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Local: both URLs are identical. Supabase: DATABASE_URL is the pooled URL,
# while DIRECT_URL is the direct/session URL used by migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tne_portal?schema=app
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tne_portal?schema=app

# Generate independently with at least 32 random bytes each.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_ACCESS_TTL_SECONDS=28800
JWT_ISSUER=tne-portal-api
JWT_AUDIENCE=tne-portal-client

# Transactional email. Create the API key at https://resend.com/api-keys and
# verify the EMAIL_FROM domain before enabling. Local/CI stays disabled by default.
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=re_replace_with_resend_api_key
EMAIL_FROM=TNE Portal <booking@example.edu.vn>
EMAIL_REPLY_TO=
FRONTEND_URL=http://localhost:5173
EMAIL_BATCH_SIZE=10
EMAIL_MAX_ATTEMPTS=5

# Optional seed values. Change immediately outside local development.
ADMIN_EMAIL=admin@tne.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=TNE Administrator

# Local/demo only. Keep false for production or Supabase production seed.
SEED_DEMO_USERS=false
DEMO_PASSWORD=Demo12345678!
