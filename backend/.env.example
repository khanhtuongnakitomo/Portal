NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
# Trust the local Vite proxy. Use false without a reverse proxy, or specify trusted IPs/CIDRs or a hop count.
TRUST_PROXY=loopback
# Opt in only for local development. The API refuses to start with this enabled in production.
DEV_TOOLS_ENABLED=false

# Local: both URLs are identical. Supabase: DATABASE_URL is the pooled URL,
# while DIRECT_URL is the direct/session URL used by migrations.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tne_portal?schema=app
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tne_portal?schema=app

# Replace the example with a secret generated from at least 32 random bytes.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_ACCESS_TTL_SECONDS=28800
JWT_ISSUER=tne-portal-api
JWT_AUDIENCE=tne-portal-client

# Required for db:seed; use an admin email distinct from demo identities.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FULL_NAME=TNE Administrator

# Local/demo only. Keep false for production or Supabase production seed.
SEED_DEMO_USERS=false
# Required (at least 12 characters) only when SEED_DEMO_USERS=true.
DEMO_PASSWORD=
